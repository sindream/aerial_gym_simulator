<?xml version="1.0"?>
<robot name="cylinder_obstacle">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.40" length="4.5"/>
      </geometry>
      <material name="obstacle_blue">
        <color rgba="0.43 0.75 1.0 1.0"/>
