<?xml version="1.0" encoding="UTF-8"?>
<robot name="monorace_quadrotor">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.16 0.12 0.04"/>
      </geometry>
      <material name="Carbon">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.886"/>
      <inertia ixx="0.0050" ixy="0.0" ixz="0.0" iyy="0.0060" iyz="0.0" izz="0.0090"/>
    </inertial>
  </link>

  <link name="front_left_prop">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.02"/>
      </geometry>
      <material name="Orange">
        <color rgba="1.0 0.42 0.04 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="front_right_prop">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.02"/>
      </geometry>
      <material name="Orange">
        <color rgba="1.0 0.42 0.04 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="back_left_prop">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.02"/>
      </geometry>
      <material name="Blue">
        <color rgba="0.10 0.30 0.95 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="back_right_prop">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.028" length="0.02"/>
      </geometry>
      <material name="Blue">
        <color rgba="0.10 0.30 0.95 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_to_front_left_prop" type="fixed" dont_collapse="true">
    <parent link="base_link"/>
    <child link="front_left_prop"/>
    <origin xyz="0.095 0.095 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_front_right_prop" type="fixed" dont_collapse="true">
    <parent link="base_link"/>
    <child link="front_right_prop"/>
    <origin xyz="0.095 -0.095 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_back_left_prop" type="fixed" dont_collapse="true">
    <parent link="base_link"/>
    <child link="back_left_prop"/>
    <origin xyz="-0.095 0.095 0" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_back_right_prop" type="fixed" dont_collapse="true">
    <parent link="base_link"/>
    <child link="back_right_prop"/>
    <origin xyz="-0.095 -0.095 0" rpy="0 0 0"/>
  </joint>
</robot>
